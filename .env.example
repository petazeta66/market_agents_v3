# ── LLM ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tavily (búsqueda web) ─────────────────────────────────────────────
# Obtén tu clave en: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────────
# URL del proyecto: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service Role Key (NUNCA al frontend): Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# Anon Key (esta sí va al frontend): Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ── Ruta a los agentes del proyecto original ─────────────────────────
# Carpeta donde están agentes.py, herramientas.py y exportar_pdf.py
# Si api.py está en la misma carpeta que los agentes, déjalo vacío.
# Si api.py está en /proyecto/backend/ y los agentes en /proyecto/, pon:
# AGENTS_DIR=/ruta/absoluta/a/tu/proyecto
AGENTS_DIR=

# ── Frontend URL (CORS) ───────────────────────────────────────────────
# En desarrollo: http://localhost:5173
# En producción: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Herramientas opcionales (del proyecto original) ───────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
EMAIL_ORIGEN=
EMAIL_PASSWORD=
EMAIL_DESTINO=
