# ── LLM ──────────────────────────────────────────────────────────────
# Obtén tu clave en: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tavily (búsqueda web) ─────────────────────────────────────────────
# Obtén tu clave en: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────────
# URL del proyecto: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service Role Key (NUNCA al frontend): Settings → API → Secret keys
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publishable Key (va al frontend): Settings → API → Publishable keys
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (CORS) ───────────────────────────────────────────────
# En desarrollo: http://localhost:5173
# En producción: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Herramientas opcionales ───────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
EMAIL_ORIGEN=
EMAIL_PASSWORD=
EMAIL_DESTINO=
