# Frontend — variables de entorno para Vite
# Copia este archivo como .env y rellena tus valores

# ── Supabase ──────────────────────────────────────────────────────────
# URL del proyecto: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon Key (pública, segura para el frontend): Settings → API → anon public
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend FastAPI ───────────────────────────────────────────────────
# En desarrollo: http://localhost:8000
# En producción: https://tu-api.railway.app (o donde despliegues)
VITE_API_URL=http://localhost:8000
